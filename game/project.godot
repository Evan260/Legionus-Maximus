; Engine configuration file.

config_version=5

[application]

config/name="Legionus Maximus"
config/description="Lead a Roman legion through endless barbarian hordes."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.2809, 0.3048, 0.1645, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/loading_screen.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=false

[autoload]

FullGame="*res://scripts/full_game.gd"
Profile="*res://scripts/profile.gd"
Lang="*res://scripts/lang.gd"
Audio="*res://scripts/audio.gd"
Steamworks="*res://scripts/steam.gd"
Landscape="*res://scripts/landscape.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=4

[internationalization]

locale/include_text_server_data=true

[editor_plugins]

enabled=PackedStringArray("res://addons/slowsunday_phone/plugin.cfg")

[gui]

theme/default_font_antialiasing=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.16, 0.1, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=true

[slowsunday]

package_name="com.slowsunday.legionusmaximus"
